# Template for .env used by docker-compose.yml in this directory.
#
# Tags are pinned deliberately. The CI action passes these in from
# .github/workflows/test-vm-nvme-kv.yml, so this file exists for local runs
# and to document what each knob does. Keep both files in step.
#
# Tags are <date>.g<ci-commit>-<component-commits>. The .g<ci-commit> field
# is what makes a tag unique. Never drop it, never use :latest.

# SPDK NVMe KV server. Built from mmgaggle/spdk@rados-nkv; upstream spdk/spdk
# has no target-side kvdev layer or nvmf_subsystem_add_kv_ns.
SPDK_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-spdk-libvfio-user:20260917.g857483b-spdk.18d1d8d

# Comma-separated namespace list in NSID order. Grammar: kind:backing[:args]
#   kv:mem[:<max_value_len>[:<max_num_keys>]]
#   lba:malloc:<size>[:<blocklen>]
#   lba:aio:<path>[:<blocklen>]
# KV values are capped at 131072 bytes by the vfio-user transport regardless
# of max_value_len. Clients must set --value-size / --data-buffer-size <= 128K.
NVME_NAMESPACES=kv:mem

# QEMU toolchain. MUST be the -sbates-fork repository: pci-mmio-bridge is not
# upstream, and qemu-tool refuses --pci-mmio-bridge on a binary without it.
QEMU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qemu-libvfio-user-sbates-fork:20260918.g7438e48-qemu.7794baa-vfu.8039244

# rocjitsu emulated GPU server.
ROCJITSU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-rocjitsu:20260918.g7438e48-rocjitsu.20d4ce1

# Only gfx_target_version 120500 has an IP discovery profile upstream.
ROCJITSU_CONFIG=gfx1250_mi455x.json

# Directory holding the guest qcow2. Bind-mounted into the qemu container at
# the same path, so use an absolute path that exists on the host.
VM_IMAGES_DIR=/var/lib/qemu-tool/images

# Must match the qcow2 basename in VM_IMAGES_DIR.
VM_NAME=batesste-ci-vm

# Guest resources. VM_SHM_SIZE must be >= VM_VMEM MiB for the memfd backend.
# Both the SPDK and rocjitsu servers reach guest RAM through memfds.
VM_VCPUS=4
VM_VMEM=8192
VM_SHM_SIZE=12g

# Host port forwarded to the guest's sshd.
VM_SSH_PORT=2222

# NVMe trace events forwarded to QEMU stderr (and collected by compose logs).
# "doorbell" is cheap; "all" expands to every pci_nvme* event.
VM_NVME_TRACE=doorbell
