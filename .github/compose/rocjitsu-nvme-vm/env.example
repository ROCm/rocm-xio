# Template for .env used by docker-compose.yml in this directory.
#
# Tags are pinned deliberately. The CI action passes these in from
# .github/workflows/test-vm-nvme.yml, so this file exists for local runs and
# to document what each knob is for.

# QEMU toolchain. MUST be the -sbates-fork repository: pci-mmio-bridge is not
# upstream, and qemu-tool refuses --pci-mmio-bridge on a binary without it.
QEMU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qemu-libvfio-user-sbates-fork:20260915-qemu.pci-mmio-bridge-submit-vfu.8039244

# rocjitsu emulated GPU server.
ROCJITSU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-rocjitsu:20260915-rocjitsu.909c17f

# Only gfx_target_version 120500 has an IP discovery profile upstream, so this
# is the only config the vfio-user front end can serve today.
ROCJITSU_CONFIG=gfx1250_mi455x.json

# Directory holding the guest qcow2. Bind-mounted into the qemu container at
# the same path, so use an absolute path that exists on the host.
VM_IMAGES_DIR=/var/lib/qemu-tool/images

# Must match the qcow2 basename in VM_IMAGES_DIR -- read it out of the
# vm-info.json shipped alongside the disk by ubuntu-qcow2-gen.
VM_NAME=batesste-ci-vm

# Guest resources. VM_SHM_SIZE must be >= VM_VMEM MiB for the memfd backend.
VM_VCPUS=4
VM_VMEM=8192
VM_SHM_SIZE=12g

# Number of emulated NVMe controllers to attach behind the MMIO bridge.
VM_NVME_COUNT=1

# Host port forwarded to the guest's sshd.
VM_SSH_PORT=2222
