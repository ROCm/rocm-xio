# Template for .env used by docker-compose.yml in this directory.
# Tags are pinned from the CI workflows. Keep in sync with the workflows.

ROCJITSU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-rocjitsu:20261021.g0f1f43f-rocjitsu.84fb06b
ROCJITSU_CONFIG=gfx1250_mi455x.json

SPDK_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-spdk-libvfio-user:20261020.g7cf462c-spdk.18d1d8d
# KV namespace in NSID order. kv:mem = memory-backed KV namespace.
NVME_NAMESPACES=kv:mem

ERNIC_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-rocm-ernic:20261020.g7cf462c-ernic.31d3114-vfu.8039244

QEMU_IMAGE=docker.io/sbates130272/batesste-ci-images-ubuntu-qemu-libvfio-user-sbates-fork:20261021.g0f1f43f-qemu.aa4344e-vfu.8039244

VM_IMAGES_DIR=/var/lib/qemu-tool/images
VM_NAME=batesste-ci-vm
VM_VCPUS=4
VM_VMEM=8192
# SHM must cover both rocjitsu GPU memfds + SPDK + ernic. 16g is safe.
VM_SHM_SIZE=16g
VM_SSH_PORT=2222

# One QEMU-emulated NVMe LBA disk
VM_NVME_COUNT=1
