; rocm-xio fio job — sequential reads from MTR_SLC (nvme1)
;
; Target: /dev/nvme1 (MTR_SLC_16GB_0400000E3CBC, unmounted)
; Queue ID 32 is the known-good value for this controller (queue_count=33).

[global]
ioengine=external:/usr/local/lib/fio/rocm-xio.so
iodepth=1
direct=1
group_reporting=1

gpu_id=0
queue_id=32
queue_depth=64
memory_mode=0
size=1g

[nvme1-seq-read-4k]
description=GPU-initiated 4K sequential reads from MTR_SLC (nvme1)
filename=/dev/nvme1
rw=read
bs=4k
numjobs=1
runtime=30
time_based=1
name=nvme1-seq-read-4k

[nvme1-seq-read-128k]
description=GPU-initiated 128K sequential reads from MTR_SLC (nvme1)
filename=/dev/nvme1
rw=read
bs=128k
numjobs=1
runtime=30
time_based=1
name=nvme1-seq-read-128k
