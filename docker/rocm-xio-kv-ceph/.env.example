# Copy to .env and edit, or pass with `docker run --env-file .env`.

# ---- Hardware: REQUIRED for the GPU E2E (build-vm/serve/gpu-e2e). ----
# No defaults -- the container fails loudly until you set these to match YOUR host.
# selftest needs none of them.
GPU_BDFS=CHANGE_ME            # GPU VGA + audio function BDFs, e.g. 0000:0c:00.0,0000:0c:00.1
NVME_BDF=CHANGE_ME            # spare NVMe BDF to pass through; NEVER your root disk
ROCXIO_NVME_DEVICE=CHANGE_ME  # guest by-id path of that NVMe, e.g. /dev/disk/by-id/nvme-<model>_<serial>
GPU_ARCH=CHANGE_ME            # guest GPU HIP arch, e.g. gfx1030 (RX 6900 XT), gfx1201 (RX 9070 XT)

# VRAM peer-DMA target: 1-based index into PCI_HOSTDEV (built as NVME_BDF,GPU_BDFS),
# so replace with index of BDFs (your GPU may have two BDFs).
VRAM_DEV_INDEX=CHANGE_ME
VRAM_BAR=0

# ---- VM shape ----
GUEST_USER=ubuntu
SSH_PORT=2223
VCPUS=8
VMEM=15360
NVME=2
IOMMU=disable
PCI_MMIO_BRIDGE=enable
VM_NAME=kv-ceph-vm

# ---- Guest test knobs ----
USE_PCI_MMIO_BRIDGE=1
TASKSET_CPUS=0-4
CTEST_LABEL_EXCLUDE=rdma

# ---- Wavefront/batched KV E2E knobs (gpu-e2e-wavefront stage) ----
# KV_KEYS: space-separated manifest stored/retrieved in one batched op.
# KV_BATCH: doorbell-batch size (default = number of keys in KV_KEYS).
KV_KEYS=wfk0 wfk1 wfk2 wfk3
KV_VALUE_SIZE=4096
KV_BATCH=4

# ---- QEMU C fork (build-time; pass these as --build-arg, NOT runtime env) ----
# Override at build time to restore it:
#   docker build \
#     --build-arg QEMU_FORK_REMOTE=<your remote> \
#     --build-arg QEMU_FORK_REF=<your branch> ...
# Defaults baked into the Dockerfile:
#   QEMU_FORK_REMOTE=https://github.com/sbates130272/qemu
#   QEMU_FORK_REF=dev/stephen/pci-mmio-bridge-submit

# ---- VM tooling source (the launcher + gen-vm; runtime env) ----
QEMU_MINIMAL_REMOTE=https://github.com/sbates130272/qemu-minimal
QEMU_MINIMAL_BRANCH=main
GENVM_SCRIPT=qemu/gen-vm
RUNVM_SCRIPT=qemu/run-vm

# ---- Guest provisioning (Ansible) source ----
# Default is the GENERAL-PURPOSE minimal branch, replace with your branch if you
# require specific system configurations.
ANSIBLE_REMOTE=https://github.com/john00003/batesste-ansible
ANSIBLE_BRANCH=users/john00003/rocm-xio-kv-docker-minimal
ANSIBLE_PLAYBOOK=playbooks/rocm-xio-kv-guest.yml
ANSIBLE_INVENTORY=playbooks/rocm-xio-kv-hosts.yml
